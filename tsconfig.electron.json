{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "outDir": "./electron/dist",
    "rootDir": "./electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@contracts": [
        "./contracts/index.d.ts"
      ],
      "@contracts/*": [
        "./contracts/*"
      ]
    }
  },
  "include": [
    "electron/**/*"
  ],
  "exclude": [
    "node_modules",
    "electron/dist",
    "client"
  ]
}
